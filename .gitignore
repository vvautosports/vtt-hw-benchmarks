# Results directory - ignore machine-generated benchmark outputs,
# but track curated experiment records under results/sweeps/
# (small JSONL + manifests; canonical until MLflow Phase 2 lands, then backfilled)
results/*
!results/.gitkeep
!results/sweeps/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
*.egg-info/
dist/
build/

# Poetry
poetry.lock

# Logs
*.log
*.log.*

# IDE
.vscode/
.idea/
.cursor/
.cursorrules
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Fixture trees are test DATA, not build output. Decoy files may use any
# extension, so the generic patterns above (*.log, *.tmp, ...) must not reach
# them — a swallowed decoy makes the fixture unsolvable in a clean checkout
# while still passing on the author's machine. Keep this rule last: git honors
# the last matching pattern.
!tasks/fixtures/**
