# Results directory - ignore machine-generated benchmark outputs,
# but track curated experiment records under results/sweeps/
# (small JSONL + manifests; canonical until MLflow Phase 2 lands, then backfilled)
results/*
!results/.gitkeep
!results/sweeps/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
*.egg-info/
dist/
build/

# Poetry
poetry.lock

# Logs
*.log
*.log.*

# IDE
.vscode/
.idea/
.cursor/
.cursorrules
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Curated experiment records under results/sweeps/ include memory and runner logs.
# The generic *.log rule above would silently drop them — the same way it swallowed
# the config-sweep fixture decoy (PR #17). Keep this after *.log so it wins.
!results/sweeps/**/*.log
